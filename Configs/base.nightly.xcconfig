// Shared Nightly settings for polkadot-app and NotificationServiceExtension.
// Leaf configs under <target>/Configs/ include this file and add only BUNDLE.
// Flags are vended as BASE_SWIFT_FLAGS so each leaf keeps its own OTHER_SWIFT_FLAGS line,
// which .github/scripts/add_swift_flags.py appends to during CI builds.
// Brand identity values come from Configs/brand.xcconfig — gitignored, created from
// Configs/brand.template.xcconfig. Identity is not in version control.
//
// ICON_SUFFIX is intentionally unset: ASSETCATALOG_COMPILER_APPICON_NAME resolves to "AppIcon".

#include "brand.xcconfig"

BASE_SWIFT_FLAGS = "-DNIGHTLY" "-DTESTNET_FEATURE" "-DFEATURE_PRIZES"

APP_NAME        = $(BRAND_DISPLAY_NAME)
APP_MAIN_BUNDLE = $(BRAND_BUNDLE_ROOT)
DEEPLINK        = $(BRAND_DEEPLINK)
