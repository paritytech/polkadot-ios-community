      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "polkadot-app"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - Calendars Full Access Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will add upcoming game to your calendar and remind you 5 minutes before the game starts."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Privacy - Calendars Write Only Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Polkadot adds games you join to your calendar with a reminder 5 minutes before they start."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Polkadot uses your camera for video calls and to scan a contact's QR code, so you can start a chat by scanning the code from their phone."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - Face ID Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Polkadot uses Face ID to confirm it's you before showing your account backup or restoring your account."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot uses your local network to connect calls directly when you call a contact on the same Wi‑Fi network."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkadot uses your microphone so contacts can hear you during voice and video calls."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Polkadot saves a photo or video from a chat to your library when you tap Save Image."
          }
        }
      }
    }
  },
  "version": "1.1"
}
