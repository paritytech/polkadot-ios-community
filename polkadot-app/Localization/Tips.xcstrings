{
  "sourceLanguage": "en",
  "strings": {
    "browse.message": {
      "comment": "Message of the tab bar tip pointing at the Browse tab",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover dApps and open them in a tab."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre dApps y ábrelas en una pestaña."
          }
        }
      }
    },
    "browse.title": {
      "comment": "Title of the tab bar tip pointing at the Browse tab",
